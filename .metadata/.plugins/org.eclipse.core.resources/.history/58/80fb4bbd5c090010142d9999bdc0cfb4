package com.example.demo.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.example.demo.models.Place;
import com.example.demo.services.PlaceService;

@RestController
@RequestMapping("/place")
public class PlaceController {
    
    @Autowired
    private PlaceService placeService;

    @PostMapping("/add")
    public ResponseEntity<Place> addPlace(@RequestBody Place place) {
        Place savedPlace = placeService.addPlace(place);
        return new ResponseEntity<>(savedPlace, HttpStatus.CREATED);
    }

    @GetMapping("/all")
    public ResponseEntity<List<Place>> getAllPlaces() {
        List<Place> places = placeService.getAllPlaces();
        return new ResponseEntity<>(places, HttpStatus.OK);
    }

    @GetMapping("/{pinCode}")
    public ResponseEntity<Place> getPlaceById(@PathVariable int pinCode) {
        Place place = placeService.getPlaceById(pinCode);
        return place != null ? new ResponseEntity<>(place, HttpStatus.OK)
                             : new ResponseEntity<>(HttpStatus.NOT_FOUND);
    }

    @PutMapping("/update/{pinCode}")
    public ResponseEntity<Place> updatePlace(@PathVariable int pinCode, @RequestBody Place updatedPlace) {
        Place place = placeService.updatePlace(pinCode, updatedPlace);
        return place != null ? new ResponseEntity<>(place, HttpStatus.OK)
                             : new ResponseEntity<>(HttpStatus.NOT_FOUND);
    }

    @DeleteMapping("/delete/{pinCode}")
    public ResponseEntity<Void> deletePlace(@PathVariable int pinCode) {
        boolean deleted = placeService.deletePlace(pinCode);
        return deleted ? new ResponseEntity<>(HttpStatus.NO_CONTENT)
                       : new ResponseEntity<>(HttpStatus.NOT_FOUND);
    }
}
